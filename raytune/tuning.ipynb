   "source": [
    "## 5. Train the YOLO26m-seg Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "66446a18",
   "metadata": {
    "_kg_hide-output": true,
    "execution": {
     "iopub.execute_input": "2026-06-26T09:03:28.397014Z",
     "iopub.status.busy": "2026-06-26T09:03:28.396371Z",
     "iopub.status.idle": "2026-06-26T09:14:13.506641Z",
     "shell.execute_reply": "2026-06-26T09:14:13.505832Z"
    },
    "papermill": {
     "duration": 645.138308,
     "end_time": "2026-06-26T09:14:13.512259+00:00",
     "exception": false,
     "start_time": "2026-06-26T09:03:28.373951+00:00",
     "status": "completed"
    },
    "scrolled": true,
    "tags": []
   },
   "outputs": [],
   "source": [
    "os.environ[\"TUNE_DISABLE_STRICT_METRIC_CHECKING\"] = \"1\"\n",
    "YOLO_MODEL = os.environ.get(\"YOLO_MODEL\", \"yolo26m-seg.pt\")\n",
    "YOLO(YOLO_MODEL)\n",
    "\n",
    "EPOCHS = int(os.environ.get(\"YOLO_EPOCHS\", \"20\"))\n",
    "BATCH = int(os.environ.get(\"YOLO_BATCH\", \"8\"))\n",
    "NUM_SAMPLES = int(os.environ.get(\"NUM_SAMPLES\", \"20\"))\n",
    "\n",
    "COMMON_ARGS = {\n",
    "    \"imgsz\": IMAGE_SIZE,\n",
    "    \"batch\": BATCH,\n",
    "    \"workers\": 2,\n",
    "    \"seed\": SEED,\n",
    "    \"deterministic\": True,\n",
    "    \"exist_ok\": True,\n",
    "    \"plots\": False,\n",
    "    \"save\": True,\n",
    "    \"val\": False,\n",
    "}\n",
    "\n",
    "def train_yolo_trial(config):\n",
    "    from ray import tune\n",
    "    import ray\n",
    "    \n",
    "    trial_args = COMMON_ARGS.copy()\n",
    "    trial_id = ray.tune.get_context().get_trial_id()\n",
    "    trial_args[\"project\"] = str(RUNS_DIR / \"tune\")\n",
    "    trial_args[\"name\"] = f\"trial_{trial_id}\"\n",
    "    trial_args[\"data\"] = str(DATA_YAML)\n",
    "    trial_args[\"epochs\"] = EPOCHS\n",
    "    \n",
    "    for k, v in config.items():\n",
    "        trial_args[k] = v\n",
    "        \n",
    "    trial_args[\"device\"] = 0 if torch.cuda.is_available() else \"cpu\"\n",
    "    \n",
    "    model = YOLO(YOLO_MODEL)\n",
    "    model.clear_callback(\"on_fit_epoch_end\")\n",
    "    train_results = model.train(**trial_args)\n",
    "    best_ckpt = Path(train_results.save_dir) / \"weights\" / \"best.pt\"\n",
    "    \n",
    "    val_summary, _ = evaluate_split_set(\n",
    "        ckpt=best_ckpt,\n",
    "        df=converted_df,\n",
    "        domain_classes=DOMAIN_CLASSES,\n",
    "        data_yaml=DATA_YAML,\n",
    "        imgsz=IMAGE_SIZE,\n",
    "        device=trial_args[\"device\"],\n",
    "        split=\"val\",\n",
    "    )\n",
    "    \n",
    "    tune.report({\n",
    "        \"mIoU\": val_summary[\"mIoU\"],\n",
    "        \"Dice\": val_summary[\"Dice\"],\n",
    "        \"mAP50_mask\": val_summary[\"mAP50_mask\"],\n",
    "        \"mAP50_95_mask\": val_summary[\"mAP50_95_mask\"],\n",
    "        \"best_ckpt\": str(best_ckpt),\n",
    "    })\n",
    "\n",
    "search_space = {\n",
    "    \"lr0\": tune.loguniform(1e-4, 1e-1),\n",
    "    \"lrf\": tune.uniform(0.01, 1.0),\n",
    "    \"momentum\": tune.uniform(0.6, 0.98),\n",
    "    \"weight_decay\": tune.loguniform(1e-5, 1e-2),\n",
    "    \"warmup_epochs\": tune.uniform(0.0, 5.0),\n",
    "    \"warmup_momentum\": tune.uniform(0.0, 0.95),\n",
    "    \"box\": tune.uniform(0.02, 0.2),\n",
    "    \"cls\": tune.uniform(0.2, 4.0),\n",
    "    \"hsv_h\": tune.uniform(0.0, 0.1),\n",
    "    \"hsv_s\": tune.uniform(0.0, 0.9),\n",
    "    \"hsv_v\": tune.uniform(0.0, 0.9),\n",
    "    \"fliplr\": tune.choice([0.0, 0.5]),\n",
    "    \"mosaic\": tune.uniform(0.0, 1.0),\n",
    "    \"mixup\": tune.uniform(0.0, 1.0),\n",
    "}\n",
    "\n",
    "\n",
    "train_fn = tune.with_resources(train_yolo_trial, resources={\"cpu\": 2, \"gpu\": 1})\n",
    "\n",
    "tuner = tune.Tuner(\n",
    "    train_fn,\n",
    "    tune_config=tune.TuneConfig(\n",
    "        metric=\"mIoU\",\n",
    "        mode=\"max\",\n",
    "        num_samples=NUM_SAMPLES,\n",
    "    ),\n",
    "    run_config=RunConfig(\n",
    "        storage_path=str(WORK_DIR / \"ray_results\"),\n",
    "        verbose=1,\n",
    "    ),\n",
    "    param_space=search_space,\n",
    ")\n",
    "\n",
    "print(\"Starting Ray Tune hyperparameter optimization...\")\n",
    "results = tuner.fit()\n",
    "\n",
    "best_result = results.get_best_result()\n",
    "best_params = best_result.config\n",
    "best_ckpt_str = best_result.metrics[\"best_ckpt\"]\n",
    "best_ckpt = Path(best_ckpt_str)\n",
    "\n",
    "print(\"\\nHyperparameter tuning complete.\")\n",
    "print(\"Best hyperparameters found:\", best_params)\n",
    "print(\"Best checkpoint path:\", best_ckpt)\n",
    "\n",
    "out_dir = WORK_DIR / \"results\"\n",
    "out_dir.mkdir(exist_ok=True)\n",
    "with open(out_dir / \"best_params.json\", \"w\") as f:\n",
    "    json.dump(best_params, f, indent=4)\n",
    "print(f\"Saved best parameters to {out_dir / 'best_params.json'}\")\n",
    "\n",
    "train_metrics = {\"best_ckpt\": str(best_ckpt)}\n",
    "print(train_metrics)\n",
    "\n"
   ]
  },
