    "- CPU Latency\n",
    "\n",
    "\"\"\"\n",
    "\n",
    "(ARTIFACTS_DIR / \"README.md\").write_text(model_card, encoding=\"utf-8\")\n",
    "print(f\"Artifacts saved to: {ARTIFACTS_DIR}\")\n",
    "print(sorted(p.name for p in ARTIFACTS_DIR.iterdir()))"
   ]
  },
