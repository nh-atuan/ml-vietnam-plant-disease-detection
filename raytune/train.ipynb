    "REPO_NAME = \"ml-vietnam-plant-disease-detection\"\n",
    "BRANCH_NAME = \"raytune\"\n",
    "\n",
    "user_secrets = UserSecretsClient()\n",
    "GITHUB_TOKEN = user_secrets.get_secret(\"GITHUB_TOKEN\")\n",
    "\n",
