{
  "openapi": "3.1.0",
  "info": {
    "title": "Plant Disease Detection API",
    "description": "Hệ thống chẩn đoán bệnh trên lá cây nông nghiệp (Cà phê / Lúa)",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/knowledge": {
      "get": {
        "tags": [
          "knowledge"
        ],
        "summary": "List Knowledge",
        "description": "List supported plant disease labels and compact metadata.",
        "operationId": "list_knowledge_api_v1_knowledge_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge/{disease_label}": {
      "get": {
        "tags": [
          "knowledge"
        ],
        "summary": "Get Knowledge",
        "description": "Get detailed Vietnamese recommendations for a disease label.",
        "operationId": "get_knowledge_api_v1_knowledge__disease_label__get",
        "parameters": [
          {
            "name": "disease_label",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Disease Label"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiseaseRecommendation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predict": {
      "post": {
        "tags": [
          "prediction"
        ],
        "summary": "Predict",
        "description": "Nhận ảnh lá cây, trả về kết quả chẩn đoán.\n\nResponse:\n{\n    \"prediction\": \"BrownSpot\",\n    \"confidence\": 0.92,\n    \"top_k\": [\n        {\"label\": \"BrownSpot\", \"confidence\": 0.92},\n        {\"label\": \"LeafBlast\", \"confidence\": 0.05},\n        ...\n    ],\n    \"recommendation\": {\n        \"name_vi\": \"Đốm nâu\",\n        \"treatments\": [...],\n        ...\n    }\n}",
        "operationId": "predict_api_v1_predict_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_predict_api_v1_predict_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_predict_api_v1_predict_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_predict_api_v1_predict_post"
      },
      "DiseaseRecommendation": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "crop": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crop"
          },
          "name_vi": {
            "type": "string",
            "title": "Name Vi"
          },
          "name_en": {
            "type": "string",
            "title": "Name En"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "symptoms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Symptoms"
          },
          "causes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Causes"
          },
          "treatments": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Treatments"
          },
          "prevention": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prevention"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeSource"
            },
            "type": "array",
            "title": "Sources"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "confidence_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence Note"
          },
          "advisory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advisory"
          }
        },
        "type": "object",
        "required": [
          "name_vi",
          "name_en"
        ],
        "title": "DiseaseRecommendation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KnowledgeListItem": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "crop": {
            "type": "string",
            "title": "Crop"
          },
          "name_vi": {
            "type": "string",
            "title": "Name Vi"
          },
          "name_en": {
            "type": "string",
            "title": "Name En"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          }
        },
        "type": "object",
        "required": [
          "label",
          "crop",
          "name_vi",
          "name_en",
          "severity"
        ],
        "title": "KnowledgeListItem"
      },
      "KnowledgeListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeListItem"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "KnowledgeListResponse"
      },
      "KnowledgeSource": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "title": "KnowledgeSource"
      },
      "PredictionResponse": {
        "properties": {
          "prediction": {
            "type": "string",
            "title": "Prediction"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "top_k": {
            "items": {
              "$ref": "#/components/schemas/TopKPrediction"
            },
            "type": "array",
            "title": "Top K"
          },
          "recommendation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiseaseRecommendation"
              },
              {
                "type": "null"
              }
            ]
          },
          "image_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          }
        },
        "type": "object",
        "required": [
          "prediction",
          "confidence",
          "top_k"
        ],
        "title": "PredictionResponse"
      },
      "TopKPrediction": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "label",
          "confidence"
        ],
        "title": "TopKPrediction"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "knowledge",
      "description": "Cơ sở tri thức chuyên gia (tiếng Việt) về các loại bệnh trên lá cây lúa và cà phê."
    },
    {
      "name": "prediction",
      "description": "Chẩn đoán bệnh trên lá cây nông nghiệp bằng mô hình YOLO26-seg (ONNX)."
    },
    {
      "name": "auth",
      "description": "Quản lý tài khoản người dùng, đăng ký, đăng nhập và phân quyền."
    },
    {
      "name": "history",
      "description": "Xem lại lịch sử các lần tải ảnh chẩn đoán bệnh và khuyến nghị tương ứng."
    }
  ]
}